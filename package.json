{
  "name": "elimquest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev:server": "npm run dev -w @elimquest/server",
    "dev:web": "npm run dev -w @elimquest/web",
    "build": "npm run build -w @elimquest/server && npm run build -w @elimquest/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "load": "tsx tests/load/run.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "tsx": "^4.20.0",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.2.15"
  }
}
