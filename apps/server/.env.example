# ElimQuest server. Copy to .env. NEVER commit real values. Names are validated in src/env.ts at boot.

NODE_ENV=development            # development | test | production
PORT=8787                       # Render injects PORT; we bind to it
LOG_LEVEL=info
PUBLIC_WEB_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173      # comma-separated exact origins; "*" is refused in production

# --- Database ---
DB_DRIVER=pglite                # pglite = dev/test only (refused in production) | pg
PGLITE_DIR=.pglite-data         # dev only: persist the local database between restarts (stable ids, kept questions); empty = in-memory
DATABASE_URL=                   # Supabase pooled connection string (Session or Transaction pooler), used when DB_DRIVER=pg
DB_POOL_MAX=5                   # keep small on free tiers

# --- Auth ---
AUTH_MODE=dev                   # dev = local accounts (dev only) | supabase
SUPABASE_URL=                   # https://<ref>.supabase.co  (public; used to verify JWT issuer + JWKS)
SUPABASE_JWT_SECRET=            # only for legacy HS256 projects; leave empty to verify via JWKS (recommended)
DEV_AUTH_SECRET=dev-only-secret-change-me-0123456789   # dev auth signing key; irrelevant in production

# --- Redis (optional: rate-limit counters; PostgreSQL stays authoritative) ---
REDIS_URL=                      # rediss://... ; empty = in-memory single-instance counters

# --- Email (Brevo transactional) ---
EMAIL_MODE=log                  # log = prints and records "not sent" (dev) | brevo
BREVO_API_KEY=                  # server-side only
BREVO_SENDER_EMAIL=             # must be a verified sender in Brevo
BREVO_SENDER_NAME=ElimQuest

# --- Game limits ---
MAX_PLAYERS_PER_ROOM=150        # hard ceiling 150. Lower this until load tests on YOUR infrastructure justify more.
MAX_ACTIVE_ROOMS=5              # live rooms at once across the platform
MAX_OPEN_ROOMS_PER_HOST=5
SPECTATOR_BUDGET_PER_ROOM=30    # read-only watchers on top of players
ANSWER_GRACE_MS=750             # server-side allowance after the deadline for network/processing
ROOM_TTL_HOURS=24
ALLOW_FIXTURE_QUESTIONS=false   # true ONLY locally; refused in production

# --- Test-only (refused in production) ---
TIMING_SCALE=1                  # scales countdown/reveal/answer windows
RATE_LIMIT_DISABLED=false
