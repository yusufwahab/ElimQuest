# ElimQuest static frontend on Apache (Namecheap shared hosting / cPanel).
# Upload the CONTENTS of apps/web/dist next to this file. If deploying in a sub-directory, set the
# build-time VITE_BASE_PATH (e.g. /quiz/) and change RewriteBase below to match.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS (enable AutoSSL / Let's Encrypt in cPanel first).
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Serve real files and folders as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Missing static assets must be a real 404 (never rewritten to index.html, which would be served as JS/CSS).
  RewriteRule \.(?:js|mjs|css|map|png|jpe?g|gif|svg|webp|avif|ico|woff2?|ttf|json|txt|xml|webmanifest)$ - [R=404,L]

  # SPA fallback for client-side routes (/join/123456, /rooms/..., /admin/...).
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Hashed build assets are immutable.
  <FilesMatch "\.(?:js|css|woff2?|png|jpe?g|svg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # index.html must always revalidate so new deploys are picked up.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Content security policy: set connect-src to your API origin (REPLACE the placeholder before deploying).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://YOUR-API.onrender.com wss://YOUR-API.onrender.com https://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
