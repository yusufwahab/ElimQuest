# ElimQuest web (build-time, public). Every VITE_ variable is shipped to browsers: NEVER put a secret here.

VITE_API_URL=                   # e.g. https://elimquest-api.onrender.com  (empty in dev: Vite proxies /api)
VITE_SOCKET_URL=                # defaults to VITE_API_URL
VITE_SUPABASE_URL=              # https://<ref>.supabase.co   (empty = local dev auth against the dev server)
VITE_SUPABASE_ANON_KEY=         # the public anon/publishable key (safe to expose; RLS protects data)
VITE_BASE_PATH=/                # "/" for a domain/subdomain root, "/quiz/" for a subdirectory deploy
VITE_DEV_API_TARGET=http://localhost:8787   # dev/preview proxy target only
